{
  "name": "Portal API Bridge (v2)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "GET",
        "path": "get-sequences",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-get",
      "name": "GET Hub Data",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [200, 200]
    },
    {
      "parameters": {
        "operation": "getAll",
        "documentId": { "__rl": true, "value": "YOUR_SHEET_ID_HERE", "mode": "id" },
        "sheetName": "Verified Emails",
        "options": {}
      },
      "id": "sheet-read",
      "name": "Sync Leads",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4,
      "position": [420, 200]
    },
    {
      "parameters": { "respondWith": "allIncomingItems", "options": {} },
      "id": "webhook-responder",
      "name": "Return Data",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
      "position": [640, 200]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "process-reply",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-post",
      "name": "Dashboard Action1",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [200, 480]
    },
    {
      "parameters": {
        "dataType": "string",
        "value1": "={{ $json.body.action }}",
        "rules": {
          "rules": [
            { "operation": "equal", "value2": "APPROVE_REBUTTAL" },
            { "operation": "equal", "value2": "APPROVE_FOLLOWUP" },
            { "operation": "equal", "value2": "STOP_SEQUENCE" }
          ]
        }
      },
      "id": "action-switch",
      "name": "Switch Action1",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 1,
      "position": [440, 480]
    },
    {
      "parameters": {
        "sendTo": "={{ $node[\"Dashboard Action1\"].json.body.email }}",
        "subject": "={{ $node[\"Dashboard Action1\"].json.body.subject || 'Follow up' }}",
        "message": "={{ $node[\"Dashboard Action1\"].json.body.draft_body }}",
        "options": {}
      },
      "id": "gmail-send",
      "name": "Dispatch Gmail1",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [640, 420]
    },
    {
      "parameters": {
        "operation": "update",
        "documentId": { "__rl": true, "value": "YOUR_SHEET_ID_HERE", "mode": "id" },
        "sheetName": "Verified Emails",
        "columnToMatchOn": "Email",
        "valueToMatchOn": "={{ $node[\"Dashboard Action1\"].json.body.email }}",
        "fields": {
          "values": [
            { "name": "Sequence_Status", "value": "Sent" },
            { "name": "Last_Sent_Date", "value": "={{ $now }}" },
            { "name": "Draft_Body", "value": "" },
            { "name": "Draft_Subject", "value": "" },
            { "name": "Last_Sent_Content", "value": "={{ $node[\"Dashboard Action1\"].json.body.draft_body }}" }
          ]
        }
      },
      "id": "sheet-reset",
      "name": "Reset Lead Status1",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4,
      "position": [880, 420]
    },
    {
      "parameters": {
        "operation": "update",
        "documentId": { "__rl": true, "value": "YOUR_SHEET_ID_HERE", "mode": "id" },
        "sheetName": "Verified Emails",
        "columnToMatchOn": "Email",
        "valueToMatchOn": "={{ $node[\"Dashboard Action1\"].json.body.email }}",
        "fields": {
          "values": [
            { "name": "Sequence_Status", "value": "Stopped" },
            { "name": "Replied", "value": "TRUE" },
            { "name": "Draft_Body", "value": "" },
            { "name": "Draft_Subject", "value": "" }
          ]
        }
      },
      "id": "stop-sequence",
      "name": "Stop Sequence Node1",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4,
      "position": [640, 560]
    }
  ],
  "connections": {
    "GET Hub Data": { "main": [[{ "node": "Sync Leads", "type": "main", "index": 0 }]] },
    "Sync Leads": { "main": [[{ "node": "Return Data", "type": "main", "index": 0 }]] },
    "Dashboard Action1": { "main": [[{ "node": "Switch Action1", "type": "main", "index": 0 }]] },
    "Switch Action1": { "main": [[{ "node": "Dispatch Gmail1", "type": "main", "index": 0 }], [{ "node": "Dispatch Gmail1", "type": "main", "index": 1 }], [{ "node": "Stop Sequence Node1", "type": "main", "index": 0 }]] },
    "Dispatch Gmail1": { "main": [[{ "node": "Reset Lead Status1", "type": "main", "index": 0 }]] }
  }
}
