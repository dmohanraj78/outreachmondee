    {
      "parameters": {
        "jsCode": "const item = $json;\n\n// Robust column lookup\nconst stepKey = Object.keys(item).find(k => k.toLowerCase().replace(/_/g, '') === 'sequencestep') || 'Sequence_Step';\nconst emailKey = Object.keys(item).find(k => k.toLowerCase() === 'email') || 'Email';\nconst nameKey = Object.keys(item).find(k => k.toLowerCase() === 'name') || 'Name';\nconst companyKey = Object.keys(item).find(k => k.toLowerCase() === 'company') || 'Company';\n\nconst step = parseInt(item[stepKey]) || 0;\nconst email = item[emailKey] || '';\nconst name = item[nameKey] || 'there';\nconst company = item[companyKey] || 'your company';\n\nlet prompt = '';\n\nif (step === 0) {\n  prompt = `Day 1 - CONVERSION: Direct value pitch. Show ${name} at ${company} exactly how Miraee solves their travel ops pain. End with a clear CTA to book a quick call.`;\n} else if (step === 1) {\n  prompt = `Day 2 - INSIGHT: Share a powerful industry insight relevant to ${company}. No hard sell. Position yourself as a thought leader. Example: Companies in your space are saving 20%+ on travel ops by automating X.`;\n} else if (step === 2) {\n  prompt = `Day 3 - FINAL (Break-up): Last touch. Keep it short and human. Wish ${name} well, mention you will not follow up again, and leave the door open. Make them feel the loss.`;\n}\n\nreturn { \n  email: email, \n  name: name, \n  company: company, \n  original_prompt: prompt,\n  next_step: step + 1\n};\n"
      },
