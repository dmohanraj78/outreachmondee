      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// 1. Access the current item's data\nconst data = $json;\n\n// 2. Find columns (Robust lookup)\nconst stepKey = Object.keys(data).find(k => k.toLowerCase().replace(/_/g, '') === 'sequencestep') || 'Sequence_Step';\nconst dateKey = Object.keys(data).find(k => k.toLowerCase().replace(/_/g, '') === 'lastsentdate') || 'Last_Sent_Date';\n\nconst step = parseInt(data[stepKey]) || 0;\nconst lastSentDate = new Date(data[dateKey]);\n\n// Safety check: if date is invalid, stop here for this item\nif (isNaN(lastSentDate.getTime())) return; \n\nconst now = new Date();\nconst diffDays = Math.floor((now - lastSentDate) / (1000 * 3600 * 24));\n\nlet shouldProcess = false;\n\n// 3. 3-Day Sprint Logic\n// Step 0 -> Step 1: 1 day gap\nif (step === 0 && diffDays >= 1) shouldProcess = true;\n// Step 1 -> Step 2: 2 days gap\nelse if (step === 1 && diffDays >= 2) shouldProcess = true;\n// Step 2 -> Step 3: 3 days gap\nelse if (step === 2 && diffDays >= 3) shouldProcess = true;\n\n// 4. Return the item if it should be processed, otherwise return null/undefined to filter it out\nif (shouldProcess) {\n  return data;\n}\n\n// Returning nothing will effectively \"filter out\" this item \n// in n8n's \"Run Once for Each Item\" mode\nreturn; \n"
      },
