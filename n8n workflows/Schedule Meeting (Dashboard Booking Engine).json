    {
      "parameters": {
        "jsCode": "const body = $json.body || $json;\n\nconst name = body.name || 'Prospect';\nconst email = body.email || '';\nconst company = body.company || 'N/A';\nconst startTime = body.startTime;\nconst endTime = body.endTime;\nconst summary = body.summary || `Meeting: ${name} x Miraee`;\nconst description = body.description || '';\nconst notes = body.notes || '';\nconst meetingType = body.meetingType || 'Demo & Discovery';\nconst sendConfirmation = body.sendConfirmation !== false;\n\n// Format dates for display — force IST timezone\nconst tz = 'Asia/Kolkata';\nconst start = new Date(startTime);\nconst dateStr = start.toLocaleDateString('en-US', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric', timeZone: tz });\nconst timeStr = start.toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit', hour12: true, timeZone: tz });\n\nconst end = new Date(endTime);\nconst endTimeStr = end.toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit', hour12: true, timeZone: tz });\n\nconst durationMins = Math.round((end - start) / 60000);\n\nreturn {\n  name,\n  email,\n  company,\n  startTime,\n  endTime,\n  summary,\n  description,\n  notes,\n  meetingType,\n  sendConfirmation,\n  dateFormatted: dateStr,\n  timeFormatted: `${timeStr} - ${endTimeStr}`,\n  durationMins\n};\n"
      },
      "id": "f6f90f08-bb66-429c-aea8-b7e16a1cb07a",
      "name": "Parse Booking Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1456,
        112
      ]
    },
    {
      "parameters": {
        "jsCode": "const booking = $node['Parse Booking Payload'].json;\nconst calendarEvent = $json;\n\n// Extract Google Meet link from calendar response\nconst meetLink = calendarEvent.hangoutLink || calendarEvent.conferenceData?.entryPoints?.[0]?.uri || '';\nconst calendarLink = calendarEvent.htmlLink || '';\n\nreturn {\n  ...booking,\n  meetLink,\n  calendarLink,\n  eventId: calendarEvent.id || ''\n};"
      },
      "id": "ddbf9f9e-d6a1-460b-afe3-68ba61721cf8",
      "name": "Merge Calendar Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1008,
        112
      ]
    },
    {
      "parameters": {
        "sendTo": "={{ $json.email }}",
        "subject": "=✅ Meeting Confirmed: {{ $json.meetingType }} with Miraee — {{ $json.dateFormatted }}",
        "message": "=<div style=\"font-family: 'Segoe UI', Arial, sans-serif; max-width: 600px; margin: 0 auto; background: #ffffff;\">\n  <div style=\"background: linear-gradient(135deg, #4F001D 0%, #7a1a3d 100%); padding: 40px 32px; border-radius: 16px 16px 0 0;\">\n    <h1 style=\"color: #ffffff; margin: 0; font-size: 24px; font-weight: 700;\">Meeting Confirmed ✓</h1>\n    <p style=\"color: rgba(255,255,255,0.7); margin: 8px 0 0; font-size: 14px;\">Your session with Miraee has been scheduled</p>\n  </div>\n  \n  <div style=\"padding: 32px; border: 1px solid #e2e8f0; border-top: none; border-radius: 0 0 16px 16px;\">\n    <p style=\"font-size: 16px; color: #1e293b; margin: 0 0 24px;\">Hi {{ $json.name }},</p>\n    \n    <p style=\"font-size: 14px; color: #475569; line-height: 1.6; margin: 0 0 24px;\">Thank you for scheduling a <strong>{{ $json.meetingType }}</strong> session with us. We're looking forward to connecting with you!</p>\n    \n    <div style=\"background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 12px; padding: 24px; margin: 0 0 24px;\">\n      <table style=\"width: 100%; border-collapse: collapse;\">\n        <tr>\n          <td style=\"padding: 8px 0; font-size: 12px; color: #94a3b8; text-transform: uppercase; letter-spacing: 1px; font-weight: 600;\">Date</td>\n          <td style=\"padding: 8px 0; font-size: 14px; color: #1e293b; font-weight: 600; text-align: right;\">{{ $json.dateFormatted }}</td>\n        </tr>\n        <tr>\n          <td style=\"padding: 8px 0; font-size: 12px; color: #94a3b8; text-transform: uppercase; letter-spacing: 1px; font-weight: 600; border-top: 1px solid #e2e8f0;\">Time</td>\n          <td style=\"padding: 8px 0; font-size: 14px; color: #1e293b; font-weight: 600; text-align: right; border-top: 1px solid #e2e8f0;\">{{ $json.timeFormatted }}</td>\n        </tr>\n        <tr>\n          <td style=\"padding: 8px 0; font-size: 12px; color: #94a3b8; text-transform: uppercase; letter-spacing: 1px; font-weight: 600; border-top: 1px solid #e2e8f0;\">Duration</td>\n          <td style=\"padding: 8px 0; font-size: 14px; color: #1e293b; font-weight: 600; text-align: right; border-top: 1px solid #e2e8f0;\">{{ $json.durationMins }} minutes</td>\n        </tr>\n        <tr>\n          <td style=\"padding: 8px 0; font-size: 12px; color: #94a3b8; text-transform: uppercase; letter-spacing: 1px; font-weight: 600; border-top: 1px solid #e2e8f0;\">Type</td>\n          <td style=\"padding: 8px 0; font-size: 14px; color: #1e293b; font-weight: 600; text-align: right; border-top: 1px solid #e2e8f0;\">{{ $json.meetingType }}</td>\n        </tr>\n      </table>\n    </div>\n    \n    <div style=\"text-align: center; margin: 0 0 24px;\">\n      <a href=\"{{ $json.meetLink }}\" style=\"display: inline-block; background: linear-gradient(135deg, #4F001D 0%, #7a1a3d 100%); color: #ffffff; text-decoration: none; padding: 14px 32px; border-radius: 8px; font-size: 14px; font-weight: 600; letter-spacing: 0.5px;\">🎥 Join via Google Meet</a>\n    </div>\n    \n    <p style=\"font-size: 13px; color: #94a3b8; text-align: center; margin: 0 0 24px;\">A calendar invitation has also been sent to your email.</p>\n    \n    <hr style=\"border: none; border-top: 1px solid #e2e8f0; margin: 24px 0;\" />\n    \n    <p style=\"font-size: 14px; color: #475569; line-height: 1.6; margin: 0 0 8px;\">Looking forward to our conversation!</p>\n    <p style=\"font-size: 14px; color: #1e293b; font-weight: 600; margin: 0;\">The Miraee Team</p>\n    <p style=\"font-size: 12px; color: #94a3b8; margin: 4px 0 0;\">Mondee Group Inc.</p>\n  </div>\n</div>",
        "options": {}
      },
