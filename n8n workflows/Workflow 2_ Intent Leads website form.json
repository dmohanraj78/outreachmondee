    {
      "parameters": {
        "jsCode": "const body = $json.body || $json;\n\n// --- RB2B PAYLOAD MAPPING ---\n// RB2B usually sends data in a flattened or person/company nested structure\nconst personName = body.person_name || body.name || \"\";\nconst personEmail = body.person_email || body.email || \"\";\nconst personLinkedin = body.person_linkedin || body.linkedin_url || \"\";\nconst companyName = body.company_name || body.company || \"\";\nconst website = body.company_domain || body.domain || \"\";\n\n// Logic: If RB2B already gave us the person, we skip AI search\nconst needsDiscovery = !personLinkedin || !personName;\n\nreturn [{ \n  json: { \n    name: personName,\n    email: personEmail,\n    company: companyName,\n    domain: website,\n    linkedin_url: personLinkedin,\n    source: \"rb2b\",\n    needs_discovery: needsDiscovery,\n    Query: needsDiscovery ? `CEO ${companyName}` : \"\"\n  } \n}];"
      },
      "id": "8dc703af-fc05-40b1-9696-d0906892d566",
      "name": "Mapping (RB2B)",
      "type": "n8n-nodes-base.code",
