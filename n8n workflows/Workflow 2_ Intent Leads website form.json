    {
      "parameters": {
        "jsCode": "let allLeads = [];\nconst results = $json.organic || [];\nconst item = $node[\"Mapping (RB2B)\"].json;\n\n// If we already have the lead from RB2B, just pass it through\nif (!item.needs_discovery) {\n  return [{\n    json: {\n      name: item.name,\n      role: \"Identified Visitor\",\n      company: item.company,\n      domain: item.domain,\n      email: item.email,\n      linkedin_url: item.linkedin_url,\n      source: \"rb2b\",\n      timestamp: new Date().toISOString()\n    }\n  }];\n}\n\n// Otherwise, sanitize the AI-discovered leads\nfor (const r of results) {\n  const titleParts = r.title.split(/[-|]/);\n  let fullName = titleParts[0].trim();\n  const names = fullName.split(\" \");\n  \n  allLeads.push({\n    json: {\n      name: fullName,\n      role: titleParts.slice(1).join(\"-\").trim() || \"Founder / Executive\",\n      company: item.company,\n      domain: item.domain,\n      email: `${names[0]?.toLowerCase()}.${names.slice(1).join(\"\").toLowerCase()}@${item.domain}`.replace(/\\s/g, \"\"),\n      linkedin_url: r.link,\n      source: \"intent_search\",\n      timestamp: new Date().toISOString()\n    }\n  });\n}\nreturn allLeads;"
      },
